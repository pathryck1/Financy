# Segredo usado para assinar os tokens JWT
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"

# Conexao com o banco de dados SQLite
DATABASE_URL="file:./dev.db"

# Porta em que a API sobe (opcional - padrao 4000)
PORT=4000

# Tempo de expiracao do token JWT (opcional - padrao 7d)
JWT_EXPIRES_IN="7d"

# Origens liberadas no CORS, separadas por virgula (opcional - padrao libera todas)
CORS_ORIGIN="http://localhost:5173"
